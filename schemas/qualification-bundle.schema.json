{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guildtechnologysolutions.com/schemas/qualification-bundle.schema.json",
  "title": "GTS-AIRST qualification evidence bundle",
  "type": "object",
  "required": ["bundle_id", "format_version", "generated_at", "repository", "implementation_commit", "repository_state", "release_state", "parent_qualification_state", "derivative_readiness_state", "release_readiness_state", "controls", "acceptance_controls", "methodology_results", "command_results", "known_limitations", "proposed_next_action"],
  "properties": {
    "bundle_id": {"const": "AIRST-HARDENING-001-QUALIFICATION-BUNDLE"},
    "format_version": {"const": "1.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "implementation_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "repository_state": {
      "type": "object", "required": ["dirty", "manifest_sha256"],
      "properties": {
        "dirty": {"type": ["boolean", "null"]},
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "release_state": {
      "type": "object", "required": ["last_declared_version", "development_state", "new_release_declared"],
      "properties": {
        "last_declared_version": {"type": "string", "minLength": 1},
        "next_planned_version": {"type": "string", "minLength": 1},
        "development_state": {"type": "string", "minLength": 1},
        "new_release_declared": {"type": "boolean"}
      }
    },
    "parent_qualification_state": {"enum": ["FAILED", "QUALIFICATION_CANDIDATE_EVIDENCE_INCOMPLETE", "QUALIFICATION_CANDIDATE_MANUAL_REVIEW", "QUALIFICATION_CANDIDATE_AUTOMATED_PASS"]},
    "derivative_readiness_state": {"enum": ["BLOCKED_FAILED_CONTROLS", "BLOCKED_MISSING_EVIDENCE", "BLOCKED_MANUAL_REVIEW", "CONTRACT_READY_PARENT_RELEASE_PIN_PENDING"]},
    "release_readiness_state": {"enum": ["BLOCKED_FAILED_CONTROLS", "BLOCKED_MISSING_EVIDENCE", "BLOCKED_MANUAL_REVIEW", "NOT_READY_NEW_RELEASE_UNDECLARED", "REVIEW_REQUIRED_PUBLICATION_AUTHORITY_NOT_ESTABLISHED"]},
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}},
    "acceptance_controls": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/control"}},
    "methodology_results": {"type": "object"},
    "command_results": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/command"}},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "proposed_next_action": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["control_id", "status", "command", "returncode", "stdout", "stderr"],
      "properties": {
        "control_id": {"enum": ["RI-REPOSITORY", "RI-AIRST-VALIDATION", "MV-EVAL-HARNESS", "RI-UNIT-TESTS"]},
        "status": {"enum": ["PASS", "FAIL"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "returncode": {"type": ["integer", "null"]},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "PASS"}}},
        "then": {"properties": {"returncode": {"const": 0}}}
      }]
    },
    "control": {
      "type": "object", "required": ["control_id", "status", "evidence", "notes"],
      "properties": {
        "control_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "MANUAL", "N/A", "UNKNOWN", "WAIVED"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "waiver": {
          "type": "object", "required": ["scope", "rationale", "authority", "risk", "expires_or_review_at"],
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "WAIVED"}}}, "then": {"required": ["waiver"]}}
      ]
    }
  }
}
