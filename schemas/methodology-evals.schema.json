{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guildtechnologysolutions.com/schemas/methodology-evals.schema.json",
  "title": "Methodology evaluation fixture contract",
  "oneOf": [{"$ref": "#/$defs/suite"}, {"$ref": "#/$defs/case"}],
  "$defs": {
    "check": {
      "type": "object",
      "required": ["path", "op", "value"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "op": {"enum": ["eq", "neq", "lte", "gte", "contains"]},
        "value": {}
      },
      "allOf": [{
        "if": {"properties": {"op": {"enum": ["lte", "gte"]}}},
        "then": {"properties": {"value": {"type": "number"}}}
      }],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["eval_id", "category", "evaluation_mode", "description", "required_behaviors", "forbidden_behaviors", "deterministic_checks", "self_test_result", "semantic_review_required", "manual_review_required"],
      "properties": {
        "eval_id": {"type": "string", "pattern": "^AR-00[1-9]$|^AR-01[0-4]$"},
        "category": {"type": "string", "minLength": 1},
        "evaluation_mode": {"enum": ["DETERMINISTIC", "HYBRID"]},
        "description": {"type": "string", "minLength": 1},
        "required_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_behaviors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "deterministic_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "self_test_result": {"type": "object"},
        "semantic_review_required": {"type": "boolean"},
        "manual_review_required": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"properties": {"evaluation_mode": {"const": "DETERMINISTIC"}}},
        "then": {"properties": {"semantic_review_required": {"const": false}}},
        "else": {"properties": {"semantic_review_required": {"const": true}}}
      }],
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": ["schema_version", "suite_id", "cases"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "suite_id": {"const": "AIRST-MV-ADVERSARIAL"},
        "cases": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/case"}}
      },
      "additionalProperties": false
    }
  }
}
