{
  "$schema": "schemas/assurance.schema.json",
  "format_version": "1.0",
  "project": "GTS-AIRST",
  "project_type": "ai-research-system-template",
  "assurance_profile": "airst-parent-hardening",
  "result_states": [
    "PASS",
    "FAIL",
    "MANUAL",
    "N/A",
    "UNKNOWN",
    "WAIVED"
  ],
  "control_domains": {
    "RI": "repository integrity",
    "MV": "methodology validation",
    "RO": "research-output qualification",
    "DQ": "derivative qualification"
  },
  "required_checks": [
    "RI-MANIFEST-INTEGRITY",
    "RI-LOCAL-LINK-INTEGRITY",
    "RI-IDENTITY",
    "RI-SCHEMAS",
    "RI-HISTORICAL-NO-TOUCH",
    "RI-WORKFLOW-PINS",
    "RI-LEAST-PRIVILEGE",
    "RI-SECRET-EXPOSURE",
    "MV-EVAL-HARNESS",
    "MV-PROVENANCE",
    "MV-TRACEABILITY",
    "MV-CONTRADICTION",
    "MV-UNCERTAINTY",
    "MV-FALSIFICATION",
    "MV-SOURCE-AUTHORITY",
    "MV-FRESHNESS-RETRACTION",
    "MV-SOURCE-DEPENDENCE",
    "MV-CAUSAL-OVERREACH",
    "MV-PROMPT-INJECTION",
    "MV-SCOPE-EXPANSION",
    "MV-AUTHORITY-ESCALATION",
    "MV-TOOL-FAILURE",
    "DQ-INVARIANTS",
    "DQ-COMPONENT-REGISTRY",
    "DQ-DERIVATIVE-MUTATION"
  ],
  "manual_controls": [
    {
      "control_id": "MV-METHODOLOGICAL-VALIDITY",
      "description": "Overall methodological validity remains a human research-method judgment."
    },
    {
      "control_id": "MV-HYBRID-SEMANTIC-REVIEW",
      "description": "Hybrid eval cases require evidence-grounded semantic review against concrete research-system outputs."
    },
    {
      "control_id": "RO-SOURCE-QUALITY-JUDGMENT",
      "description": "Source authority and quality can require qualified human/domain judgment."
    },
    {
      "control_id": "RO-CLAIM-SUFFICIENCY",
      "description": "Material claim sufficiency can require human/domain review."
    },
    {
      "control_id": "RO-ETHICAL-LEGAL-REVIEW",
      "description": "Ethical and legal review remains manual where applicable."
    },
    {
      "control_id": "DQ-DOMAIN-AUTHORITY-REVIEW",
      "description": "A derivative domain authority profile requires review before qualification."
    }
  ],
  "release_requirements": {
    "automated_failures_allowed": 0,
    "unknown_requires_review": true,
    "waivers_require_expiration": true
  }
}
